1class Solution {
2public:
3
4    // bfs approach
5    bool bfs(vector<vector<int>>& graph, vector<int>& color, int node){
6        queue<int> q; 
7        q.push(node);
8        while(!q.empty()){
9            int curr = q.front();
10            q.pop();
11            for(auto n : graph[curr]){
12                if(color[n] == -1){
13                    color[n] = !color[curr];
14                    q.push(n);
15                }
16                else if(color[n] == color[curr]) return false;
17            }
18        }
19        return true;
20    }
21
22    // dfs approach
23    bool dfs(vector<vector<int>>& graph, vector<int>& color, int node){
24        for(auto i : graph[node]){        
25            if(color[i] == -1){
26                color[i] = !color[node];
27                if(!dfs(graph,color,i)) return false;
28            }
29            else if(color[i] == color[node]) return false;
30        }
31        return true;
32    }
33
34    bool isBipartite(vector<vector<int>>& graph) {
35        int n = graph.size();
36        vector<int> color(n,-1);
37        for(int i = 0; i < n; i++){
38            if(color[i] == -1){
39                color[i] = 0;
40                // if(!dfs(graph,color,i)) return false;
41                if(!bfs(graph,color,i)) return false;
42            }
43        }
44        return true;
45    }
46};